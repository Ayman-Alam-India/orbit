# Copy this file to .env (never commit .env). Every value has a safe default, so .env is optional.

# Port for the API server. The Vite dev server proxies /api to it.
PORT=8787

# mock = seed data only (default, works offline). live = seed data + live sources, falling back to cache/seed.
DATA_MODE=mock

# mock = canned answers (default, no key needed). google = Gemini via Google AI Studio (falls back to mock on any failure).
AI_PROVIDER=mock

# Google AI Studio key, only needed when AI_PROVIDER=google. Leave empty in this file. Put the real key in your local .env.
GOOGLE_GENERATIVE_AI_API_KEY=

# Gemini model(s) for AI_PROVIDER=google, tried in order (free-tier models get overloaded). Any Google AI Studio model works.
GOOGLE_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite

# Groq key (free tier, console.groq.com): the second model that independently verifies AI claims.
# Leave empty to verify with Gemini + the offline rule-based checker only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Narrator voice for the guided tour and "Listen" (Gemini text-to-speech, same key as above).
# Clips are cached in server/.cache/speech, so each sentence is generated once. No key = browser voice.
GOOGLE_TTS_MODEL=gemini-3.1-flash-tts-preview,gemini-2.5-flash-preview-tts
GOOGLE_TTS_VOICE=Charon
